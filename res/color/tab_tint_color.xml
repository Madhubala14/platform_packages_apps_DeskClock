<?xml version="1.0" encoding="utf-8"?>
<!-- iOS tab bar: accent orange when selected, system gray otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@color/ios_orange" />
    <item android:state_selected="true" android:color="@color/ios_orange" />
    <item android:color="@color/ios_label_secondary" />
</selector>
