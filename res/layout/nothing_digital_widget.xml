<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nothing_digital_widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_nothing"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingBottom="14dp"
    android:paddingEnd="18dp"
    android:paddingStart="18dp"
    android:paddingTop="14dp">

    <!-- Dot-matrix time. Leading zero on purpose (09:41), like Nothing OS. -->
    <TextClock
        android:id="@+id/nothing_time"
        style="@style/nothing_widget_time"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:autoSizeMaxTextSize="120sp"
        android:autoSizeMinTextSize="28sp"
        android:autoSizeTextType="uniform"
        android:format12Hour="hh:mm"
        android:format24Hour="HH:mm"
        android:gravity="start|center_vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            android:src="@drawable/nothing_red_dot" />

        <TextClock
            android:id="@+id/nothing_date"
            style="@style/nothing_widget_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEE d MMM"
            android:format24Hour="EEE d MMM"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/nothing_next_alarm"
            style="@style/nothing_widget_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/nothing_red"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
